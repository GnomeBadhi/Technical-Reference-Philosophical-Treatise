# File: ktr-langarian.dkr
FROM texlive/texlive:latest

# Set working directory
WORKDIR /work

# Copy manuscript into container
# Assume your LaTeX file is named: main.tex
# (rename the earlier manuscript to main.tex before building)
COPY main.tex /work/main.tex

# Default command: compile the PDF
CMD ["sh", "-c", "pdflatex -interaction=nonstopmode main.tex && ls -lh && echo 'Build complete: main.pdf'"]
